rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['CAMERA', 'CHECKPOINT', 'ALCOBLOW']
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.get('uid', null) == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trialStartedAt'])
        && request.resource.data.trialStartedAt == request.time;
      allow update, delete: if false;
    }

    match /playPurchases/{token} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
