<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to src/main/res/values/secrets.xml (git-ignored) and fill in. Needs the "Maps SDK for Android" enabled on the
     key, restricted to package com.rada.android + your debug/release SHA-1. -->
<resources>
    <string name="google_maps_key" translatable="false">YOUR_MAPS_API_KEY</string>
    <!-- Only needed if google-services.json has no web client (it normally does once Google sign-in is enabled). -->
    <string name="google_web_client_id" translatable="false"></string>
</resources>
